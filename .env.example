# Qunkins Environment Variables

# Required
QUNKINS_SECRET=your-secret-key-min-32-chars

# Optional (with defaults)
QUNKINS_PORT=9800
QUNKINS_DB_PATH=./data/qunkins.db
QUNKINS_LOG_DIR=./logs
QUNKINS_AUTH_ENABLED=true
QUNKINS_BOOTSTRAP_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Feishu (get from https://open.feishu.cn/)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-app-secret
